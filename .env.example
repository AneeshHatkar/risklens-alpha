# RiskLens Alpha environment configuration
# Copy this file to .env for local development.
# Do not commit your real .env file.

APP_NAME=RiskLens Alpha
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Market data provider settings
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_START_DATE=2024-01-01
MARKET_DATA_BENCHMARK=SPY
MARKET_DATA_TIMEOUT_SECONDS=20

# Optional future API keys
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=
OPENAI_API_KEY=

# Cache settings
ENABLE_CACHE=true
CACHE_DIR=.cache/risklens
CACHE_TTL_SECONDS=900

# Database settings
DATABASE_URL=sqlite:///./risklens_alpha.db

# Background job settings
ENABLE_BACKGROUND_JOBS=false
MARKET_REFRESH_INTERVAL_MINUTES=5
NEWS_REFRESH_INTERVAL_MINUTES=30

# Safety settings
ENABLE_NO_ADVICE_SAFETY=true
